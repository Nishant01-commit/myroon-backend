# Server
NODE_ENV=development
PORT=5000

# Local dev default below. In production (Render), set this to your real
# frontend origin instead, e.g. CLIENT_URL=https://myroomm.in
CLIENT_URL=http://localhost:3000

# Database
# Get this from MongoDB Atlas -> Connect -> Drivers. This file only ever
# holds placeholders — put the real value in your local .env (gitignored)
# and in Render's dashboard env vars, never in a file that gets committed.
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/myroomm?retryWrites=true&w=majority

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis / BullMQ (needed from Phase 4 onward)
REDIS_URL=redis://localhost:6379

# Cloudinary (needed from Phase 3 onward)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (needed from Phase 4 onward)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (needed from Phase 4 onward)
RESEND_API_KEY=
EMAIL_FROM="MyRoomm <no-reply@myroomm.in>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Booking pricing — confirm the real applicable GST rate with your accountant/current
# CBIC rules before launch; this default is a placeholder, not tax advice.
GST_PERCENT=12
PLATFORM_FEE_PERCENT=5
